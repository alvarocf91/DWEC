<!DOCTYPE html>
<html>
<head>
    <title>Prestar Libro</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<h1>Prestar libro</h1>

<form action="/prestamo/nuevo" method="POST">
    <input type="hidden" name="libro_id" value="<%= libro_id %>">

    <label>Nombre:</label>
    <input type="text" name="nombre" required>

    <label>Fecha devolución:</label>
    <input type="date" name="fecha_devolucion" required>

    <button>Prestar</button>
</form>

</body>
</html>