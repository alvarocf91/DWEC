<!DOCTYPE html>
<html>
<head>
    <title>Prestados</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<h1>Libros Prestados</h1>

<table>
<tr>
    <th>Título</th>
    <th>Autor</th>
    <th>Usuario</th>
    <th>Devolución</th>
</tr>

<% libros.forEach(l => { %>
<tr>
    <td><%= l.titulo %></td>
    <td><%= l.autor %></td>
    <td>
        <a href="/prestamos/usuario?nombre=<%= l.nombre_prestatario %>">
            <%= l.nombre_prestatario %>
        </a>
    </td>
    <td><%= l.fecha_devolucion %></td>
</tr>
<% }) %>

</table>

</body>
</html>