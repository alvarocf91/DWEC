<!DOCTYPE html>
<html>
<head>
    <title>Préstamos por usuario</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<h1>Libros prestados a: <%= nombre %></h1>

<table>
<tr>
    <th>Título</th>
    <th>Autor</th>
    <th>Devolución</th>
</tr>

<% prestamos.forEach(p => { %>
<tr>
    <td><%= p.titulo %></td>
    <td><%= p.autor %></td>
    <td><%= p.fecha_devolucion %></td>
</tr>
<% }) %>

</table>

</body>
</html>